{
  "manifest_version": 3,
  "name": "RP2040 Password Key",
  "version": "0.1.0",
  "description": "Browser-only secure integration for RP2040 password key.",
  "action": {
    "default_title": "RP2040 Key",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "hid"
  ],
  "web_accessible_resources": [],
  "host_permissions": [
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*/*"
      ],
      "js": [
        "content-script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none';"
  }
}
